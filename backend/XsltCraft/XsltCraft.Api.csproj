<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>xsltcraft-api-secrets</UserSecretsId>
    <Version>1.11.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XsltCraft.Application\XsltCraft.Application.csproj" />
    <ProjectReference Include="..\XsltCraft.Domain\XsltCraft.Domain.csproj" />
    <ProjectReference Include="..\XsltCraft.Infrastructure\XsltCraft.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Middleware\" />
  </ItemGroup>

  <!--
    İzole XSLT worker: yalnız build sırası (assembly referansı YOK — Api, worker kodunu yüklemez).
    Çıktı $(OutDir)xsltworker\ altına kopyalanır; XsltWorkerLocator varsayılan olarak orada arar.
    Docker/CI'da worker ayrı publish edilir → -p:BuildXsltWorker=false.
  -->
  <ItemGroup Condition="'$(BuildXsltWorker)' != 'false'">
    <ProjectReference Include="..\XsltCraft.XsltWorker\XsltCraft.XsltWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyXsltWorkerOutput" AfterTargets="Build" Condition="'$(BuildXsltWorker)' != 'false'">
    <MSBuild Projects="..\XsltCraft.XsltWorker\XsltCraft.XsltWorker.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_XsltWorkerTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_XsltWorkerOutDir>@(_XsltWorkerTargetPath->'%(RootDir)%(Directory)')</_XsltWorkerOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_XsltWorkerFiles Include="$(_XsltWorkerOutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_XsltWorkerFiles)"
          DestinationFiles="@(_XsltWorkerFiles->'$(OutDir)xsltworker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
