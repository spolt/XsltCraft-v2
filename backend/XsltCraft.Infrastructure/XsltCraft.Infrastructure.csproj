<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.11.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XsltCraft.Application\XsltCraft.Application.csproj" />
    <ProjectReference Include="..\XsltCraft.Domain\XsltCraft.Domain.csproj" />
    <!-- İzole XSLT worker IPC sözleşmesi (bağımlılıksız). Worker exe'nin kendisine referans YOK. -->
    <ProjectReference Include="..\XsltCraft.XsltWorker.Contracts\XsltCraft.XsltWorker.Contracts.csproj" />
    <!-- Süreç içi grid host'u (InProcessXsltHost) için Saxon-HE 12.10 / IKVM. IKVM/Maven bildirimi YALNIZ
         Xslt.Saxon'da (LayeringTests); dönüşmüş derlemeler + ikvm home ProjectReference zinciriyle Api çıktısına iner
         (IkvmFlowTests.ApiOutput_ContainsSaxonAndIkvmHome). -->
    <ProjectReference Include="..\XsltCraft.Xslt.Saxon\XsltCraft.Xslt.Saxon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Parsers\" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Threading.RateLimiting (AiVisionThrottle) — önceden yalnız Swashbuckle üzerinden transitif geliyordu. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XsltCraft.Infrastructure.Tests" />
    <InternalsVisibleTo Include="XsltCraft.XsltWorker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.412.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

</Project>
