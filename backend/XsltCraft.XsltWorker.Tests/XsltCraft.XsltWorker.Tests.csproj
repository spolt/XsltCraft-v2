<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XsltCraft.Infrastructure\XsltCraft.Infrastructure.csproj" />
    <ProjectReference Include="..\XsltCraft.XsltWorker.Contracts\XsltCraft.XsltWorker.Contracts.csproj" />
    <!-- Gerçek worker süreci: yalnız build sırası; çıktı Api'deki gibi $(OutDir)xsltworker\ altına kopyalanır,
         böylece testler XsltWorkerLocator'ın üretimdeki varsayılan (apphost) yolunu kullanır. -->
    <ProjectReference Include="..\XsltCraft.XsltWorker\XsltCraft.XsltWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyXsltWorkerOutput" AfterTargets="Build">
    <MSBuild Projects="..\XsltCraft.XsltWorker\XsltCraft.XsltWorker.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_XsltWorkerTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_XsltWorkerOutDir>@(_XsltWorkerTargetPath->'%(RootDir)%(Directory)')</_XsltWorkerOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_XsltWorkerFiles Include="$(_XsltWorkerOutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_XsltWorkerFiles)"
          DestinationFiles="@(_XsltWorkerFiles->'$(OutDir)xsltworker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
