storage/themes/*
storage/assets/*
!storage/themes/.gitkeep
!storage/assets/.gitkeep

# ----------------------
# Environment
# ----------------------
.env
.env.local
.env.development
.env.production
.env.example

# Visual Studio
.vs/
*.vsidx
launchSettings.json

# Sensitive config
**/appsettings.Development.json

# ----------------------
# Frontend
# ----------------------
frontend/**/node_modules
frontend/**/dist
frontend/**/.env

# OS
.DS_Store
Thumbs.db

# ----------------------
# Logs
# ----------------------
*.log

# Templates
*.xslt

# Misc
*.log
*.tmp

# Root-level npm artifacts (accidental installs)
/node_modules/
/package-lock.json

# PRD v2 (internal doc)
XsltCraft_PRD_v2.md

# Claude Code — local settings & session data ignored; shared agents + skills tracked
.claude/*
!.claude/agents/
!.claude/skills/

# Verify (snapshot testing) — received files are transient, never commit
*.received.*

# Test run artifacts (trx, coverage)
[Tt]est[Rr]esults/
test-results/

# Playwright (E2E) artifacts — browsers global, raporlar geçici
playwright-report/
blob-report/
playwright/.cache/
.last-run.json
.playwright-mcp/
